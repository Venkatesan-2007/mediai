# Medical AI RAG Chatbot Configuration
# Copy this to .env.local or .env and fill in your values

# ============================================================================
# OLLAMA LLM CONFIGURATION (Recommended)
# ============================================================================
# Ollama provides high-quality local LLM models with no API keys needed
# Models tested: mistral, neural-chat, llama2, orca-mini
#
# Install Ollama: https://ollama.ai
# Pull a model: ollama pull mistral
# Run: ollama serve (in a separate terminal)

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ============================================================================
# SAMBANOVA LLM CONFIGURATION (Optional - Premium)
# ============================================================================
# SambaNova provides high-performance cloud LLM endpoints
# If configured, takes priority over Ollama
#
# Get API key from: https://cloud.sambanova.ai/
# This is a fallback if Ollama is not available

SAMBANOVA_API_KEY=
SAMBANOVA_API_URL=

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL settings for user authentication and document storage
# If not configured, uses SQLite (development only)

DATABASE_URL=sqlite:///./medical_db.db

# ============================================================================
# VECTOR STORE CONFIGURATION
# ============================================================================
# ChromaDB vector database for semantic search
# Data persists in the database/chroma_db directory

CHROMA_DB_PATH=database/chroma_db

# ============================================================================
# EMBEDDING MODEL
# ============================================================================
# Model used for semantic embeddings (RAG search)
# Options: all-MiniLM-L6-v2 (small, fast), all-mpnet-base-v2 (large, accurate)

EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================================================
# OCR & SIGNATURE ANALYSIS
# ============================================================================
# Tesseract path - auto-detected on Windows/macOS/Linux
# Only set if auto-detection fails
#
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux: /usr/bin/tesseract
# macOS: /usr/local/bin/tesseract

TESSERACT_PATH=

# ============================================================================
# API & SECURITY
# ============================================================================
# JWT Secret for authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# INFERENCE SETTINGS (Optimize for your hardware)
# ============================================================================
# Max tokens for LLM responses (lower = faster but less detailed)
LLM_MAX_TOKENS=256

# Temperature for sampling (0.0-1.0, lower = more consistent)
LLM_TEMPERATURE=0.3

# Number of relevant chunks to use for RAG
RAG_CHUNK_COUNT=3
