# ============================================
# PRODUCTION CONFIGURATION - OLLAMA FOCUSED
# ============================================
# Primary LLM: Ollama (Mistral)
# Fallback chain: Ollama → LocalLLM

# --- SAMBANOVA CONFIGURATION (DISABLED) ---
# Leave empty to skip SambaNova and use Ollama
SAMBANOVA_API_KEY=
SAMBANOVA_API_URL=

# --- OLLAMA CONFIGURATION (PRIMARY LLM) ---
# Base URL for Ollama service 
# Docker: http://ollama:11434
# Local: http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434

# Ollama Model: mistral (7B, balanced speed/quality)
# Options: neural-chat (fast), llama2 (reasoning), dolphin-mixtral (MoE)
OLLAMA_MODEL=mistral

# --- DATABASE CONFIGURATION ---
# PostgreSQL connection URL for Docker environment
DATABASE_URL=postgresql://postgres:password@postgres:5432/medi_ai

# --- ENVIRONMENT SETTINGS ---
FLASK_ENV=production
DEBUG=False

# --- JWT SECURITY ---
SECRET_KEY=your-super-secret-key-change-this-in-production-to-something-very-long-and-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# --- LOGGING ---
LOG_LEVEL=INFO

# --- DEPRECATED: Other API Providers (kept for reference) ---
# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo

# Anthropic Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Google AI Configuration
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-pro