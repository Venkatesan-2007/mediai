# Ollama LLM Configuration (Secondary Backend)
# =============================================

# Ollama Base URL - When running in Docker
OLLAMA_BASE_URL=http://ollama:11434

# Ollama Base URL - When running locally
# OLLAMA_BASE_URL=http://localhost:11434

# Ollama Model Selection
# Options: mistral, neural-chat, llama2, dolphin-mixtral, zephyr
# Recommended for medical context: mistral, neural-chat
OLLAMA_MODEL=mistral

# Primary LLM Configuration
# Leave empty to disable SambaNova and use Ollama instead
# SAMBANOVA_API_KEY=your_api_key_here
# SAMBANOVA_API_URL=https://api.sambanova.ai/v1

# Database Configuration
DATABASE_URL=postgresql://postgres:password@postgres:5432/medi_ai
