# ============================================
# OPTIMIZED CONFIGURATION FOR OLLAMA ONLY
# ============================================
# This config disables SambaNova API and uses
# Ollama (Mistral) for FAST responses

# --- DISABLE SambaNova (leave empty to skip) ---
SAMBANOVA_API_KEY=
SAMBANOVA_API_URL=

# --- OLLAMA CONFIGURATION (PRIMARY) ---
# Base URL for Ollama service
OLLAMA_BASE_URL=http://ollama:11434

# Model: mistral (7B, balanced speed/quality)
# Faster options: neural-chat (fastest), orca-mini (smaller)
OLLAMA_MODEL=mistral

# --- DATABASE ---
DATABASE_URL=postgresql://postgres:password@postgres:5432/medi_ai

# --- ENVIRONMENT ---
FLASK_ENV=production
